# Port server backend
PORT=4000

# Kunci penandatangan JWT. Ganti dengan string acak yang panjang sebelum deploy.
JWT_SECRET=studytrack-secret-key-change-this

# Fitur Saran Rencana (Google Gemini). Kunci dibuat di aistudio.google.com.
# Biarkan kosong untuk menonaktifkan fitur; endpoint akan membalas 503.
GEMINI_API_KEY=
GEMINI_MODEL=
